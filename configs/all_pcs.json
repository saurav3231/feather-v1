    "moe_kernel": "auto",
    "moe_experts": 64,
    "moe_top_k": 1,
    "moe_active_percent": 1.5,
    "batch_size": 1,
    "ram_budget_gb": 0.8,
    "adaptive_range": {
      "hypervector_dim": "512-10000 (2KB-40KB)",
      "chunk_size": "32-64",
      "TT_rank": "4-16",
      "threads": "1-physical cores"
    }
