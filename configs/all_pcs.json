{
  "model_name": "feather-v1-42M",
  "version": "1.0.0",
  "description": "Auto-hardware adaptive config — works for ALL PCs: i5-3337U to i9, Ryzen, Apple M, Raspberry Pi",
  "auto_hardware": true,
  "feather_v1_config": {
    "dim": 384,
    "hypervector_dim": "auto",
