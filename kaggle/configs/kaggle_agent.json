{
  "model_name": "feather-v1-kaggle-agent",
  "version": "1.0.0",
  "description": "Feather v1 for tiny 1-core / 2-thread agent runtimes (1.9GB RAM): smallest profile so it fits anywhere a Kaggle notebook runs.",
  "hardware_target": "1-core 2-thread agent host (1.9GB RAM) / Kaggle CPU",
  "harness": true,
  "ladder": true,
  "pipeline": true,
  "neurosymbolic": true,
  "hierarchical_attention": true,
  "hidden_markov": true,
  "prediction_head": "euclidean-gradient-hypervector|one: one-hot",
  "stdout_view": "restructured-text|linear-chunked|euclidean-gauge-ticker",
  "matplotlib_surface": true,
  "feather_v1_config": {
    "dim": 64,
    "seq_len": 128,
    "chunk_size": 16,
    "num_chunks": 8,
    "hypervector_dim": 1024,
    "alpha_fractional": 0.7,
    "K_frac_recent": 16,
    "K_frac_long": 64,
    "TT_rank": 4,
    "tau_tropical": 0.1,
    "p_adic_p": 2,
    "threads": 1,
    "precision": "int8",
    "binding": "auto",
    "moe": "auto",
    "n_experts": 32,
    "moe_top_k": 1,
    "sinkhorn_eps": 0.1,
    "sinkhorn_iters": 3,
    "batch_size": 1,
    "ram_budget_gb": 0.6,
    "seed": 42,
    "vocab_size": 4096
  },
  "expected_performance": {
    "tok_per_sec": "3-5 (single core)",
    "ram_saving_vs_hbm": "17.5x vs 14GB",
    "energy_per_1k_j": 0.028,
    "memory_saving": "512x",
    "ops_saving": "64x",
    "training_steps": "K-FAC hybrid 10x fewer",
    "threads": 1
  }
}