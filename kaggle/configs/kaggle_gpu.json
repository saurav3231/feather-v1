{
  "model_name": "feather-v1-kaggle-gpu",
  "version": "1.0.0",
  "description": "Feather v1 on a Kaggle GPU host: the model stays CPU-native (no torch needed), the 30GB host RAM / 14GB HBM holds the packaging pipeline and GGUF artifacts. GPU is deliberately unused.",
  "hardware_target": "Kaggle GPU host (CPU execution, 30GB RAM / 14GB HBM)",
  "harness": true,
  "ladder": true,
  "pipeline": true,
  "neurosymbolic": true,
  "hierarchical_attention": true,
  "hidden_markov": true,
  "prediction_head": "euclidean-gradient-hypervector|one: one-hot",
  "stdout_view": "restructured-text|linear-chunked|euclidean-gauge-ticker",
  "matplotlib_surface": true,
  "feather_v1_config": {
    "dim": 512,
    "seq_len": 512,
    "chunk_size": 32,
    "num_chunks": 16,
    "hypervector_dim": 10000,
    "alpha_fractional": 0.7,
    "K_frac_recent": 32,
    "K_frac_long": 128,
    "TT_rank": 16,
    "tau_tropical": 0.1,
    "p_adic_p": 2,
    "threads": 4,
    "precision": "int8",
    "binding": "auto",
    "moe": "auto",
    "n_experts": 64,
    "moe_top_k": 1,
    "sinkhorn_eps": 0.1,
    "sinkhorn_iters": 3,
    "batch_size": 1,
    "ram_budget_gb": 1.2,
    "seed": 42,
    "vocab_size": 8192
  },
  "expected_performance": {
    "tok_per_sec": "45-60 (CPU-only, GPU idle)",
    "ram_saving_vs_hbm": "17.5x vs 14GB",
    "energy_per_1k_j": 0.028,
    "memory_saving": "512x",
    "ops_saving": "64x",
    "training_steps": "K-FAC hybrid 10x fewer",
    "threads": 4
  }
}