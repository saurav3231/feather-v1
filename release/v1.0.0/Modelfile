# Feather v1 Modelfile (Ollama)
#
#   ollama create feather-v1 -f Modelfile
#   ollama run feather-v1 "namaste, xasan"
#
# num_gpu 0: Feather v1 is CPU-native; leaving GPU idle is the point.
# num_thread 2 matches the i5-3337U reference hardware (2C/4T).

FROM ../dist/feather-v1-q4_k_m.gguf

PARAMETER num_thread 2
PARAMETER num_gpu 0
PARAMETER temperature 0.7
PARAMETER top_k 3
PARAMETER num_ctx 512

TEMPLATE """{{- if .System }}<|system|>{{ .System }}</|system|>
{{- end }}<|user|>{{ .Prompt }}</|user|>
<|assistant|>{{ .Response }}</|assistant|>"""